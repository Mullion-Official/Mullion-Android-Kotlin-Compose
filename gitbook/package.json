{
  "name": "mullion-gitbook",
  "private": true,
  "version": "1.0.0",
  "description": "MULLION SDK documentation built with HonKit (GitBook doc-template compatible)",
  "scripts": {
    "clean": "rm -rf _book",
    "sync": "bash scripts/sync_guides.sh",
    "build": "bash scripts/sync_guides.sh && honkit build",
    "serve": "honkit serve"
  },
  "devDependencies": {
    "honkit": "^5.1.3",
    "gitbook-plugin-simple-page-toc": "^0.1.2",
    "gitbook-plugin-github": "^2.0.0",
    "gitbook-plugin-github-buttons": "^2.1.0",
    "gitbook-plugin-edit-link": "^2.0.2",
    "gitbook-plugin-anchors": "^0.7.1",
    "gitbook-plugin-anchor-navigation-ex": "^1.0.10",
    "gitbook-plugin-splitter": "^0.0.8",
    "gitbook-plugin-expandable-chapters-small": "^0.1.7",
    "gitbook-plugin-tbfed-pagefooter": "^0.0.1",
    "gitbook-plugin-sitemap-general": "^0.1.1",
    "gitbook-plugin-advanced-emoji": "^0.2.2"
  }
}
